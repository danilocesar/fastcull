import { LineEdit, ComboBox, Button, Palette, ScrollView } from "std-widgets.slint";

// FastCull main window: virtualized zoomable grid (specs/modules/ui-grid.md).
// The Rust side owns all layout math; `cells` contains ONLY the visible
// window (+margin) of cells with absolute positions inside the Flickable.
// M5 adds the menu bar, the filter/sort bar, the inbox-zero empty state and
// the keyboard-shortcuts popup.

export struct CellData {
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    has-image: bool,
    failed: bool,
    label: string,
    is-cursor: bool,
    selected: bool,
    id: int,
    copied: bool,
    // #56: this frame is in a video this session exported that is still
    // on disk. Per FRAME, not per burst — the export's scope is an
    // arbitrary set, and an opener-only badge would lie about a partial
    // burst.
    exported: bool,
    // M7: burst size shown on the group's FIRST frame only (0 = none).
    burst-count: int,
    seed: int,
    // 0 = unmarked, 1 = picked (star), 2 = rejected (X + dim)
    pick: int,
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 24px;
    width: t.preferred-width + 18px;
    border-radius: 12px;
    background: root.active ? #3a6ea5 : #2c2c30;
    t := Text {
        text: root.label;
        color: root.active ? #ffffff : #b8b8c0;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// One answer to the Copy dialog's clash question (fileops.md): a
// full-width row carrying the key that answers it, what it does, and what
// it costs. Deliberately not a std Button — none of the three answers may
// look like the default action, and the labels are far too long to sit
// side by side in the card.
component AnswerRow inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <string> cost;
    in property <color> label-color: #e8e8f0;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: ta.has-hover ? #33333d : #26262e;
    border-width: 1px;
    border-color: #3a3a44;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;
        Text {
            text: root.key;
            color: #8a8a96;
            font-size: 12px;
            vertical-alignment: center;
            width: 30px;
        }
        Text {
            text: root.label;
            color: root.label-color;
            font-size: 13px;
            vertical-alignment: center;
            // The label carries a FILE NAME, and a long one used to paint
            // straight through the card's right edge and out over the
            // grid behind it (seen on a 45-character name in the video
            // export's question). Stretch to the room there is, and
            // elide inside the row rather than outside the dialog.
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.cost;
            color: #9898a8;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Modal scaffolding shared by the Help > Shortcuts and About popups:
// full-area scrim, click-outside-to-close, wheel swallowed (validator M2
// — TouchAreas pass unhandled scrolls through to the Flickable below),
// and a centred card of the house style.
//
// Layout only. The two popups' KEY handling deliberately stays in the
// root key scopes where PR #43 put it (the focus-continuity rules), and
// every difference between the two cards is a property here rather than
// a silent drift: card height, card padding, and whether clicks on the
// card itself are swallowed.
component ModalScrim inherits Rectangle {
    // MANDATORY — Slint has no required property, and an unset length is
    // 0px, so a call site that forgets this used to get NO CARD AT ALL:
    // the scrim darkened, the text floated over the grid unclipped, and
    // nothing said why (verified by unbinding it on the About site).
    // Unset now means FULL HEIGHT (see the card's `height` below) — still
    // wrong, but unmissable and impossible to mistake for a correct card.
    // Both existing sites bind it, so no pixel moves.
    in property <length> card-height;
    in property <length> card-padding: 16px;
    in property <bool> card-eats-clicks: false;
    // The Copy Picks dialog is a third copy of this scaffolding that has
    // not been absorbed (it needs a wider card, and it hosts a FocusScope
    // as an ANCESTOR of the whole dialog, which this component cannot
    // host today). The width is a property so that migration is not
    // blocked on this file; the default is what both current sites use,
    // so no pixel moves.
    in property <length> card-width: 480px;
    callback dismissed();
    y: 0; // missing-binding trap (issue #12): unset y centered the scrim 13px low
    background: #000000aa;
    TouchArea {
        clicked => { root.dismissed(); }
        scroll-event(e) => { return accept; }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        // The `> 0px` arm is the unbound-property trap above, not a layout
        // choice: an unset card-height means "fill", never "vanish".
        height: root.card-height > 0px
            ? min(root.card-height, parent.height - 40px)
            : parent.height - 40px;
        border-radius: 8px;
        background: #202028;
        border-width: 1px;
        border-color: #3a3a44;
        if root.card-eats-clicks: TouchArea { } // clicks on the card never close it
        VerticalLayout {
            padding: root.card-padding;
            spacing: 8px;
            @children
        }
    }
}

// Wheel sub-notch accumulator, shared by the two surfaces that zoom on
// the wheel (the fit surface and the zoom overlay).
//
// One notch = one ladder stop: winit delivers 60px per wheel notch
// (validated against the backend source, and PINNED by
// `overlay_wheel_still_zooms_one_stop_per_notch` — 59 px fires nothing,
// the 60th px fires a stop, so a backend that changed the conversion
// fails a test instead of quietly making every notch a fraction of a
// stop); subtracting rather than zeroing keeps the remainder for hi-res
// devices, and a direction flip resets the residue so a reversal never
// fires late. `feed` returns +1/-1 when a notch fires (0 otherwise) and
// also leaves it in `last`, because a callback body cannot hold a local.
component WheelNotches {
    property <length> acc: 0;
    out property <int> last: 0;
    public function feed(dy: length) -> int {
        if ((dy > 0 && self.acc < 0) || (dy < 0 && self.acc > 0)) {
            self.acc = 0;
        }
        self.acc += dy;
        if (self.acc >= 60px) {
            self.acc -= 60px;
            self.last = 1;
            return 1;
        }
        if (self.acc <= -60px) {
            self.acc += 60px;
            self.last = -1;
            return -1;
        }
        self.last = 0;
        return 0;
    }
}

// One IPTC panel field row (iptc-templates.md tri-state UI rule, v1
// reading): bare emptiness preserves; the per-field clear control acts
// IMMEDIATELY (revert-covered) — no pending-clear badge state. mixed =
// selection holds differing values (typing overwrites all).
export struct IptcFieldRow {
    label: string,
    value: string,
    mixed: bool,
}

export struct KeywordChip {
    text: string,
    // "34/50" coverage on multi-selection, "" on single image.
    coverage: string,
}

export component MainWindow inherits Window {
    title: "FastCull";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: #161618;

    // FastCull is DARK-ONLY, by decision, and the palette must say so
    // (user bug 2026-08-02, decision "I don't want a light mode. I don't
    // want a toggle. Keep the design as is"). Every surface in this file
    // is a hand-picked dark colour — but native widgets (MenuBar, the
    // panel's LineEdits) take their text colours from the style palette,
    // which follows the PLATFORM colour scheme. On a light-mode desktop
    // that made the menu bar's labels near-black on our near-black bar:
    // invisible, yet clickable, while the OPENED menus stayed readable
    // because a popup draws its own palette background. Pinning the
    // scheme here makes every palette-derived colour consistent with the
    // one design this app actually has.
    init => { Palette.color-scheme = ColorScheme.dark; }

    in property <[CellData]> cells: [];
    in property <length> virtual-height: 0px;
    in property <string> status: "";
    in property <bool> one2one: false;
    // Selection wash (user request 2026-07-28): hue and strength of the tint
    // over selected grid cells. Deliberately PROPERTIES, not literals — the
    // user's decision is that the strength becomes a user setting later, so
    // the plumbing to drive it from outside the UI already exists. Rust owns
    // the defaults (SELECTION_WASH_* in state.rs); a future settings pane
    // writes these same two properties and nothing else has to change.
    in property <color> selection-wash: #4da3ff;
    in property <float> selection-wash-opacity: 0.25;
    in property <image> loupe-image;
    in property <length> loupe-w: 0px;
    in property <length> loupe-h: 0px;
    // Zoomed-loupe pan offsets (<= 0), applied directly to the overlay
    // image's position. RUST IS THE ONLY WRITER (issue #46 single-writer
    // rule): drags arrive as loupe-dragged events and come back as
    // programmatic writes — nothing on the Slint side may ever set these,
    // which `in` (not `in-out`) makes the compiler enforce. The M3 bug
    // class (a binding animating the offsets underneath Rust) starts
    // with the first Slint-side writer.
    in property <length> loupe-vx: 0px;
    in property <length> loupe-vy: 0px;
    // The loupe overlay area (Rust needs it for fit/1:1 factor math). The
    // overlay's height is content.height - statusbar.height, and keys is
    // ALREADY statusbar-short — so this is keys.height exactly (validator
    // finding: subtracting the statusbar here again put every anchor 13px
    // high and let bottom-edge clamps masquerade as user drags).
    out property <length> loupe-area-h: keys.height;
    // IPTC panel (M5): visibility, field rows, keyword chips, templates.
    in-out property <bool> iptc-visible: false;
    in property <[IptcFieldRow]> iptc-fields: [];
    in property <[KeywordChip]> iptc-keywords: [];
    in property <[string]> iptc-templates: [];
    in property <string> iptc-batch-label: "";
    in property <string> iptc-warning: "";
    in property <string> iptc-revert-label: "";
    in property <bool> iptc-revert-enabled: false;
    // Set by Rust when K should land focus in the keyword field.
    in-out property <bool> iptc-focus-keywords: false;
    // Session generation, bumped by Rust on every folder swap (#41 D3):
    // editors stamp the generation when they GAIN focus, and a blur
    // commit from a stale generation DISCARDS instead (user decision:
    // swapping folders mid-edit discards the un-committed text). This is
    // structural, not timing-based — without it the focus-return steal
    // blurred a still-alive keyword editor AFTER the swap and the G7
    // click-away rule committed the OLD session's half-typed text
    // against the NEW session's image (found while verifying the fix).
    in property <int> session-gen: 0;
    property <length> panel-w: root.iptc-visible ? 300px : 0;
    // Filter/sort bar state (M5): counts per chip, the active single-choice
    // filter, and the sort cycle label. All owned by Rust.
    in property <int> counts-all: 0;
    in property <int> counts-picked: 0;
    in property <int> counts-rejected: 0;
    in property <int> counts-unmarked: 0;
    in property <string> active-filter: "all";
    in property <string> sort-label: "Capture ↑";
    in property <bool> filter-bar-visible: true;
    // Inbox-zero / empty-view message ("" = view has images).
    in property <string> empty-message: "";
    // Copy Picks dialog (M6, fileops.md dialog minimums). copy-state:
    // 0 = planning/preview, 1 = running, 2 = report.
    in-out property <bool> copy-visible: false;
    in property <int> copy-state: 0;
    in property <string> copy-dest: "";
    in-out property <string> copy-template: "";
    in property <string> copy-last-template: "";
    in property <string> copy-summary: "";
    in property <string> copy-preview: "";
    in property <string> copy-collisions: "";
    // The clash question (copy-state 3, fileops.md "The clash question"):
    // a STATE of this dialog, not a second modal — the same key scope, the
    // same Esc rules, no new stacking surface (issue #42). Every string is
    // built in Rust; the two answers' keys are printed in their rows, so
    // no mnemonic has to be guessed.
    in property <string> copy-confirm: "";
    in property <string> copy-confirm-examples: "";
    in property <string> copy-confirm-keep-both: "";
    in property <string> copy-confirm-keep-both-cost: "";
    in property <string> copy-confirm-overwrite: "";
    in property <string> copy-confirm-cancel: "";
    in property <string> copy-confirm-warning: "";
    // Shown after a key that is NOT an answer (Enter and Space included —
    // they must never answer this question): a dead key reads as a frozen
    // dialog, so the question says what it is waiting for.
    in property <string> copy-confirm-nudge: "";
    in-out property <bool> copy-confirm-nudged: false;
    // Export Frames as Video dialog (M9, video-export.md). Same states as
    // the copy dialog — 0 = plan, 1 = writing, 2 = report, 3 = the clash
    // question — deliberately, so the two exits behave identically under
    // the keyboard.
    in-out property <bool> clip-visible: false;
    in property <int> clip-state: 0;
    in property <string> clip-dest: "";
    // The ONE plan line: frames, size, cadence, duration, bytes, name,
    // free space. Composed in Rust; core owns every rule inside it.
    in property <string> clip-summary: "";
    in property <string> clip-skipped: "";
    // #56: "3 of 30 frames are already in DSC05010-DSC05039.mov" — one
    // line, empty when none of the scope has been exported this session.
    in property <string> clip-exported-hint: "";
    in property <string> clip-error: "";
    in property <bool> clip-ready: false;
    in property <string> clip-progress: "";
    in property <string> clip-report: "";
    in property <string> clip-confirm: "";
    in property <string> clip-confirm-keep-both: "";
    in property <string> clip-confirm-overwrite: "";
    in property <string> clip-confirm-cancel: "";
    in property <string> clip-confirm-nudge: "";
    in-out property <bool> clip-confirm-nudged: false;
    in-out property <bool> clip-claim-focus: false;
    // Is there anything to export right now? Drives the menu item's
    // enabled state; the KEY still works and explains itself in the
    // status line (video-export.md: never a silent grey item).
    in property <bool> clip-available: false;
    in property <string> copy-error: "";
    in property <bool> copy-ready: false;
    in property <string> copy-progress: "";
    in property <string> copy-report: "";
    // Scrollbar drag hint: "first-visible / total" (task #21).
    in property <string> scroll-hint: "";
    in-out property <bool> shortcuts-visible: false;
    // About dialog (issue #23): dedicated modal; the version string is
    // composed by the build (X.Y.Z on a release tag, otherwise
    // X.Y.Z-devel-YYYYMMDD-<hash> — issue #26).
    in-out property <bool> about-visible: false;
    in property <string> about-version;
    // FOCUS CONTINUITY (issues #41/#42): keyboard focus must always live
    // in the TOPMOST surface's key scope — whenever the focused editor is
    // destroyed (panel close, session swap) or covered (a modal opens),
    // focus deterministically returns there. focus-keys() is the routing
    // primitive: the copy dialog's own scope while the dialog is up (via
    // copy-claim-focus — the scope is a conditional child this function
    // cannot name; and routing to `keys` instead left the main key
    // handler LIVE behind the dialog, where N/Y fired real marks at the
    // hidden grid — validator delta finding), else the main `keys`
    // scope. BOTH scopes contain the About/shortcuts modals: Esc closes
    // the topmost modal only, every other key is swallowed — so with
    // About over the copy dialog the first Esc closes About and the
    // dialog's plan state survives (issue #42; the old behavior let Esc
    // act on the HIDDEN dialog and threw its state away).
    // The menu-path caveat (issue #41 D2): Slint's MenuBar restores
    // focus to the previously-focused element AFTER the item activation
    // runs, so a synchronous focus-keys() inside an activation is
    // overridden. The Rust side therefore re-invokes this function
    // QUEUED behind the current event dispatch (refocus_topmost_deferred)
    // after every such transition, and the panel/copy editors bounce a
    // focus gain that arrives while a modal covers them (see the
    // changed has-focus handlers) — belt and braces, both deterministic.
    public function focus-keys() {
        // Topmost first: the video export can be opened over nothing, but
        // both dialogs are modal and only one is ever up.
        //
        // The owner token is written HERE, synchronously, and not left to
        // the gaining scope's `changed has-focus` (issue #63): that
        // handler runs an event-loop iteration later, and a rows rebuild
        // in between would read the stale EDITOR id and pull the keyboard
        // straight back out of the grid — measured undoing the shipped G4
        // rule that Enter commits and returns to the grid.
        if (root.clip-visible) {
            root.clip-claim-focus = true;
            root.focus-owner = -1;
        } else if (root.copy-visible) {
            root.copy-claim-focus = true;
            root.focus-owner = -1;
        } else {
            keys.focus();
            root.focus-owner = 0;
        }
    }
    // The copy dialog watches this flag and claims its scope (same
    // pattern as iptc-focus-keywords: a root flag observed by a
    // conditional child).
    in-out property <bool> copy-claim-focus: false;
    // WHO OWNS THE KEYBOARD (issues #63/#64) — the token that makes "a
    // destroyed editor never keeps the focus token" checkable from Rust:
    //
    //   0     the main key scope (`keys`), or nothing app-owned
    //   1..N  panel field row i, written as i + 1
    //   N+1   the keyword field
    //   -1    a dialog's own key scope (Copy Picks / Export Frames)
    //
    // Slint's window holds a WEAK reference to its focus item, so an
    // editor destroyed by a model replacement delivers NO FocusOut and
    // nothing reassigns focus — measured: the keyboard was ownerless for
    // 17-525 ms after every session swap mid-edit, until a zero-length
    // timer happened to run. Rust reads this token immediately after such
    // a mutation and reclaims in the same pass (focus::
    // reclaim_destroyed_editors).
    //
    // Only a GAIN ever writes it — never a loss. Two measured reasons,
    // both of which a clear-on-loss gets wrong:
    //
    //  * `changed has-focus` handlers run on the next event-loop
    //    iteration, and the GAINER's runs first on this tree (click Title
    //    then Description: `iptc field 1 gained` at [3733], `iptc field 0
    //    lost` at [3735]) — so a loss-write would land after the new
    //    owner's and blank it.
    //  * a row destroyed by a rebuild and the row RECREATED in its place
    //    share the same id, so the dying item's late blur cannot be told
    //    apart from the live one's ([3762] the new row 1 claims, [3835]
    //    the old row 1 finally announces its loss).
    //
    // The cost is a token that goes stale when focus leaves for something
    // Slint owns — a menu popup, or the WINDOW being deactivated, which
    // sends a FocusOut while keys still route (see the harness section on
    // `keysfocus`). Staleness is the safe direction: the reclaim then
    // hands the keyboard back to the field the user was editing, which is
    // where it was. Clearing would strand it instead.
    in-out property <int> focus-owner: 0;
    // WHICH ROW GETS THE KEYBOARD BACK after a rows rebuild destroyed the
    // editor that had it (issue #63 F3): the row index, or -1 for "nobody
    // asked". Rust sets it in the same pass as the model replacement; the
    // RECREATED row observes it, focuses itself and clears it — the same
    // root-flag-watched-by-a-child pattern as `iptc-focus-keywords`,
    // because a repeater's children cannot be named from Rust.
    //
    // The keyboard goes back to the FIELD, never to the grid: the panel is
    // a captioning surface, iptc-templates.md's "focus stays where
    // clicked" is a shipped rule, and a rebuild that lands the keys on the
    // grid turns the next character of a caption into a cull command —
    // `x` rejects the photo and writes a sidecar. Only a session SWAP
    // reclaims to the grid instead, because there the field's meaning is
    // gone with the folder (#41 D3).
    in-out property <int> iptc-refocus-row: -1;
    // WHICH GENERATION OF THAT ROW (issue #63 FAIL-1). Arming the index
    // alone is not enough and was a live defect: a repeater's children
    // are NOT torn down when the model is replaced — they die at the next
    // update — so the DOOMED instance is still alive, still watching, and
    // its `changed want-refocus` runs first. It consumed the flag in the
    // rebuild's own millisecond, focused itself, cleared the flag, and
    // then died; the recreated row never saw anything, and the keyboard
    // was on a destroyed item with `focus-owner` still reading that row.
    // Measured 10/10 dead on a cursor-move rebuild.
    //
    // So the flag carries the `iptc-rebuild-gen` it was armed for, and a
    // row claims only if it was BORN for that generation. The doomed
    // instance carries the previous one and cannot consume. The
    // menu-reassert path arms with the CURRENT generation, which is the
    // live row's own, so that path still works through the same watch.
    in-out property <int> iptc-refocus-gen: -1;
    // REBUILD GENERATION (issue #63 F2), the `session-gen` pattern applied
    // to the item tree: Rust bumps it immediately before every field-rows
    // model replacement. An editor stamps it on focus gain, and its blur
    // handler commits only if the stamp still matches — so an editor whose
    // row was destroyed under it DISCARDS its in-flight text, which is the
    // recorded 2026-08-03 rule (no commit-on-destroy), while a real
    // click-away or Tab (no rebuild in between) still commits exactly as
    // before.
    //
    // A plain "suppress the next blur commit" boolean cannot do this job:
    // `changed has-focus` is deferred, so a flag set and cleared around
    // the reclaim is already back to false by the time the handler reads
    // it, and one left set for a whole refresh tick would swallow real
    // click-away commits. A generation compare needs no timing at all.
    in-out property <int> iptc-rebuild-gen: 0;
    // Debug facility (issue #41, documented in ui-grid.md): the main key
    // scope's REAL focus state, readable from the drive harness (`dump.`
    // token). Keyboard focus was otherwise invisible to headless runs —
    // a stranded keyboard could not be asserted, so it shipped.
    out property <bool> dbg-keys-focus: keys.has-focus;
    // Debug facility (issues #13/#61, documented in ui-grid.md): a panel
    // field row reports its own laid-out rectangle in WINDOW coordinates,
    // which the harness traces. A driven click on a field is a click at a
    // point the script chose before the app existed; whether the field is
    // THERE yet is a layout outcome, and on a loaded machine the layout
    // pass can be seconds late — the flake issue #61 records. With this a
    // script can `wait:` for the row instead of guessing, and the test can
    // assert afterwards that the point it aimed at was inside the rect.
    callback dbg-field-laid-out(int, length, length, length, length);
    // The same facility for the two dialog CARDS and their button rows
    // (issue #62). A card whose height follows its content can no longer
    // be read off the .slint file — it is a layout outcome, and the
    // property that matters ("the buttons are inside the card") is a
    // relation between two rectangles. The string names which one:
    // "clip card", "clip buttons", "copy card", "copy buttons".
    callback dbg-card-laid-out(string, length, length, length, length);
    // Where a dialog's scrolling body currently stands. Nothing else in a
    // run can see it: the body has no cursor and no selection, so "PgDn
    // moved the report" is otherwise only checkable by eye.
    callback dbg-body-scrolled(string, length);
    // FOCUS OBSERVABILITY (issues #63/#64). Keyboard focus was invisible
    // to every headless run except as `keysfocus` at a dump — one sample,
    // long after the fact — which is how a stranded keyboard shipped
    // twice. These two say who holds it and who asked for it:
    //
    //   dbg-focus-changed("keys"|"iptc field N"|"keyword field"|
    //                     "copy dialog"|"clip dialog", gained)
    //   dbg-focus-claim("swap"|"cell-click"|…)  — a claim was MADE, which
    //   is not the same as a claim that landed and stayed.
    //
    // Every element that reports here also writes `focus-owner` on a
    // gain, so the trace and the token can never disagree about who took
    // the keyboard.
    //
    // Traced through `trace_mark_with`, so they cost nothing when tracing
    // is off; a focus change is rare enough that even the formatting
    // would not matter.
    callback dbg-focus-changed(string, bool);
    callback dbg-focus-claim(string);
    // A plain note from the .slint side, traced verbatim: used for the
    // item-tree events that are neither a focus change nor a claim ("the
    // keyword editor now exists"), which is exactly what a run needs to
    // read a focus loss caused by a rebuild.
    callback dbg-note(string);
    // Scroll offset (negative Flickable viewport-y); Rust reads and writes it.
    in-out property <length> vp-y: 0px;
    // Geometry the Rust layout math needs (the grid area = flickable size).
    out property <length> grid-width: content.width - panel-w;
    out property <length> grid-height: keys.height - bar-h;

    property <length> bar-h: root.filter-bar-visible ? 34px : 0px;

    callback viewport-changed();
    callback nav(string);
    callback set-filter(string);
    callback cycle-sort();
    callback toggle-filter-bar();
    callback open-folder();
    callback quit();
    // Click-to-zoom (ui-grid.md: a click is always "center HERE").
    // loupe-clicked: fractional image coordinates inside the zoom overlay.
    callback loupe-clicked(float, float);
    // loupe-dragged(dx, dy): logical-px pointer displacement of an active
    // overlay drag (issue #46). Rust folds it through the pointer
    // machine's Zoomed×Drag row and rewrites loupe-vx/vy synchronously —
    // the ONE writer of the offsets. The overlay deliberately has no
    // Flickable and therefore no fling physics: a release stops the
    // image dead (the pointer contract promises "pan 1:1 with pointer
    // motion", never inertia), and no animation can survive into a
    // navigation or programmatic pan write.
    callback loupe-dragged(float, float);
    // Pointer state machine (issue #11, ui-grid.md Mouse & pointer
    // contract): normalized events routed to fastcull-core::pointer.
    // pointer-wheel(up, ctrl, x, y): one notch-equivalent, view-area
    // coords (overlay coordinate system — content top-left).
    callback pointer-wheel(bool, bool, length, length);
    // fit-clicked: a click at fit changes nothing (spec Q5) — it only
    // claims the cursor, so it carries no coordinates.
    callback fit-clicked();
    callback fit-double-clicked(length, length);
    callback zoom-double-clicked(length, length);
    callback cell-double-clicked(int);
    // True at loupe fit (columns == 1, no zoom overlay): the fit pointer
    // surface intercepts the wheel there (it zooms; browsing is
    // keyboard-only — user decision, issue #11).
    in property <bool> at-fit;
    // Set on any scrollbar interaction (drag move / track click); Rust
    // consumes it. The loupe follow-scroll claim is POSITIVE-GATED on
    // this (issues #16/#22 family): claim heuristics that inferred
    // "user scrolled" from displacement alone kept misfiring on
    // relayout/load/DPI timing windows — the scrollbar is the ONLY
    // legitimate trigger (cursor contract), so it says so explicitly.
    in-out property <bool> sb-activity;
    // True while the zoom overlay renders from a rung BELOW the file's
    // best (issue #21: soft transit at the carried factor). Drives the
    // cue pill — "you are never SILENTLY looking at soft pixels".
    in property <bool> loupe-soft;
    // Loupe state badge (issue #20): the cursor's mark in the loupe.
    // 0 = unmarked (badge hidden), 1 = picked, 2 = rejected — same
    // encoding as CellData.pick. Swapped by the same refresh pass that
    // swaps the image (a wrong-frame badge is a confident lie).
    in property <int> loupe-mark: 0;
    // Cell click (issue #7 + click-to-zoom at loupe fit): image id,
    // cell-local coordinates, ctrl/shift modifiers (selection semantics).
    // Lives IN the cell so the Flickable keeps drag-scrolling (a sibling
    // overlay TouchArea killed grid drags — gate finding).
    callback cell-clicked(int, length, length, bool, bool);
    // IPTC panel (M5). Field edits commit by row index; Enter returns
    // focus to the grid and the cursor STAYS (G4 final).
    callback iptc-toggle();
    // kitchen-ready: the texture worker finished something; Rust drains
    // and adopts. Pure plumbing — the UI declares it so the worker can
    // wake the event loop through invoke_from_event_loop.
    callback kitchen-ready();
    callback iptc-field-committed(int, string, bool);
    callback iptc-field-clear(int);
    callback iptc-keyword-added(string);
    callback iptc-keyword-removed(int);
    callback iptc-apply-template(int);
    callback iptc-revert();
    // Copy Picks (M6): open plans immediately; replan fires on any input
    // change; start runs the plan; cancel stops between files.
    callback copy-open();
    callback copy-pick-dest();
    callback copy-replan();
    callback copy-start();
    callback copy-answer-keep-both();
    callback copy-answer-overwrite();
    callback copy-answer-cancel();
    callback copy-cancel();
    callback copy-close();
    callback copy-open-dest-folder();
    // Export Frames as Video (M9): the same shape as the copy callbacks.
    callback clip-open();
    callback clip-pick-dest();
    callback clip-start();
    callback clip-answer-keep-both();
    callback clip-answer-overwrite();
    callback clip-answer-cancel();
    callback clip-cancel();
    callback clip-close();
    callback clip-open-dest-folder();

    changed vp-y => { root.viewport-changed(); }
    // Alias kept for the Rust G4 paths; routes like focus-keys so no
    // caller can steal from the copy dialog's scope by accident.
    public function focus-grid() { root.focus-keys(); }
    // Fired by the Help menu items: the Rust side answers with the
    // deferred re-focus that survives the menu's focus restore (#41 D2).
    callback modal-opened();
    // Fired FIRST by every menu item, whatever it does (issue #63, QE
    // finding 2026-08-30). Activating any item blurs a focused panel
    // field, which COMMITS it (G7) — and a commit rebuilds the field
    // rows, destroying the editor. The MenuBar then restores focus to
    // that destroyed item AFTER the activation returns, so the keyboard
    // lands on nothing and no synchronous reclaim can survive it:
    // measured dead 5 times in 5 through View > Filter Bar, which unlike
    // View > IPTC Panel had no deferred claim of its own.
    //
    // The Rust side answers by RE-ASSERTING THE OWNER TOKEN one event
    // loop later, rather than by grabbing the keys: after a menu action
    // the keyboard belongs wherever it belonged before, which for a panel
    // field is that field (iptc-templates.md "focus stays where
    // clicked"). Blanket-claiming `keys` here would be the same defect as
    // reclaiming a rebuild to the grid.
    callback menu-activated();
    changed width => { root.viewport-changed(); }
    changed height => { root.viewport-changed(); }

    forward-focus: keys;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open Folder…";
                activated => { root.menu-activated(); root.open-folder(); }
            }
            MenuItem {
                title: "Copy Picks… (Ctrl+E)";
                activated => { root.menu-activated(); root.copy-open(); }
            }
            MenuItem {
                // The user's own wording: "video", not "clip".
                title: "Export Frames as Video… (Ctrl+Shift+E)";
                // Greyed when there is nothing to export — but the
                // keystroke still answers, with the reason, in the status
                // line (video-export.md).
                enabled: root.clip-available;
                activated => { root.menu-activated(); root.clip-open(); }
            }
            MenuItem {
                title: "Settings… (soon)";
                enabled: false;
            }
            MenuItem {
                title: "Quit";
                activated => { root.menu-activated(); root.quit(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Zoom In (+)";
                activated => { root.menu-activated(); root.nav("zoom-in"); }
            }
            MenuItem {
                title: "Zoom Out (-)";
                activated => { root.menu-activated(); root.nav("zoom-out"); }
            }
            MenuItem {
                title: "IPTC Panel (I)";
                activated => { root.menu-activated(); root.iptc-toggle(); }
            }
            MenuItem {
                title: "Filter Bar";
                activated => { root.menu-activated(); root.toggle-filter-bar(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                // modal-opened, not a bare focus-keys(): the menu restores
                // focus AFTER activation, overriding any steal made here
                // (issue #41 D2 — the un-dismissable modal + blind typing
                // into the field hidden behind the scrim).
                activated => { root.menu-activated(); root.shortcuts-visible = true; root.modal-opened(); }
            }
            MenuItem {
                title: "About FastCull";
                activated => { root.menu-activated(); root.about-visible = true; root.modal-opened(); }
            }
        }
    }

    content := Rectangle {
        keys := FocusScope {
            // Same missing-binding trap as issue #12, vertical: without an
            // explicit y the scope centered 13px low, hiding the grid's
            // bottom strip behind the status bar.
            x: 0;
            y: 0;
            width: 100%;
            height: parent.height - statusbar.height;
            // The main scope's own focus, as it changes (issues #63/#64),
            // and the owner token: `keys` holding the keyboard is the
            // state in which no rebuild has anything to reclaim.
            changed has-focus => {
                root.dbg-focus-changed("keys", self.has-focus);
                if (self.has-focus) { root.focus-owner = 0; }
            }

            key-pressed(event) => {
                // Modal containment (issue #23, user decision 2026-07-27:
                // "swallow everything in that screen"): while a popup is
                // up, Esc closes it and EVERY other key dies here — the
                // persona found the old Esc-only guard let N/Y/arrows act
                // on the grid under the scrim ("the popup that teaches
                // you the keys lets you fire them blind"). A stray N
                // while reading About must never reject a photo.
                if (root.about-visible) {
                    if (event.text == Key.Escape) { root.about-visible = false; }
                    return accept;
                }
                if (root.shortcuts-visible) {
                    if (event.text == Key.Escape) { root.shortcuts-visible = false; }
                    return accept;
                }
                if (event.modifiers.control) {
                    if (event.text == "o" || event.text == "O") { root.open-folder(); return accept; }
                    if (event.text == "q" || event.text == "Q") { root.quit(); return accept; }
                    if (event.text == "a" || event.text == "A") { root.nav("select-all"); return accept; }
                    // Ctrl+Shift+E BEFORE Ctrl+E: with Shift held the
                    // event still arrives as the letter plus modifiers, so
                    // without this order the chord would open Copy Picks.
                    // A chord, not a bare letter, so it cannot fire from a
                    // fat finger mid `]`/`N` (persona 2026-08-27).
                    if (event.modifiers.shift && (event.text == "e" || event.text == "E")) {
                        root.clip-open();
                        return accept;
                    }
                    if (event.text == "e" || event.text == "E") { root.copy-open(); return accept; }
                    // Ctrl+Shift+B: select the whole burst under the
                    // cursor (issue #55). A chord for the same reason as
                    // Ctrl+Shift+E: it acts on many frames at once.
                    if (event.modifiers.shift && (event.text == "b" || event.text == "B")) {
                        root.nav("select-burst");
                        return accept;
                    }
                    return reject;
                }
                if (event.modifiers.shift) {
                    if (event.text == Key.LeftArrow) { root.nav("shift-left"); return accept; }
                    if (event.text == Key.RightArrow) { root.nav("shift-right"); return accept; }
                    if (event.text == Key.UpArrow) { root.nav("shift-up"); return accept; }
                    if (event.text == Key.DownArrow) { root.nav("shift-down"); return accept; }
                    // Shift+] / Shift+[ (issue #55). On a US layout the
                    // key arrives as "}" / "{" — the shifted character —
                    // so both spellings are the same key here.
                    if (event.text == "]" || event.text == "}") { root.nav("shift-burst-next"); return accept; }
                    if (event.text == "[" || event.text == "{") { root.nav("shift-burst-prev"); return accept; }
                }
                if (event.text == "i" || event.text == "I") { root.iptc-toggle(); return accept; }
                if (event.text == "k" || event.text == "K") {
                    // K: open the panel if needed AND land in the keyword
                    // field (persona: K must never be a dead key).
                    root.iptc-focus-keywords = true;
                    if (!root.iptc-visible) { root.iptc-toggle(); }
                    return accept;
                }
                if (event.text == "[") { root.nav("burst-prev"); return accept; }
                if (event.text == "]") { root.nav("burst-next"); return accept; }
                // The shifted brackets without a reported Shift modifier
                // (a layout where "{" / "}" are their own keys): still the
                // burst-selection keys, never dead.
                if (event.text == "{") { root.nav("shift-burst-prev"); return accept; }
                if (event.text == "}") { root.nav("shift-burst-next"); return accept; }
                if (event.text == Key.LeftArrow) { root.nav("left"); return accept; }
                if (event.text == Key.RightArrow) { root.nav("right"); return accept; }
                if (event.text == Key.UpArrow) { root.nav("up"); return accept; }
                if (event.text == Key.DownArrow) { root.nav("down"); return accept; }
                if (event.text == Key.PageUp) { root.nav("pgup"); return accept; }
                if (event.text == Key.PageDown) { root.nav("pgdn"); return accept; }
                if (event.text == Key.Home) { root.nav("home"); return accept; }
                if (event.text == Key.End) { root.nav("end"); return accept; }
                if (event.text == "+" || event.text == "=") { root.nav("zoom-in"); return accept; }
                if (event.text == "-") { root.nav("zoom-out"); return accept; }
                if (event.text == "y" || event.text == "Y" || event.text == "p" || event.text == "P" || event.text == " ") { root.nav("pick"); return accept; }
                if (event.text == "n" || event.text == "N" || event.text == "x" || event.text == "X") { root.nav("reject"); return accept; }
                if (event.text == "u" || event.text == "U") { root.nav("clear"); return accept; }
                if (event.text == "z" || event.text == "Z") { root.nav("one2one"); return accept; }
                if (event.text == "g" || event.text == "G") { root.nav("grid"); return accept; }
                // Esc: back to the grid AND the selection cleared, from
                // anywhere (user decision 2026-08-28, issue #55).
                if (event.text == Key.Escape) { root.nav("esc"); return accept; }
                reject
            }

            if root.filter-bar-visible: Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: root.bar-h;
                background: #1d1d21;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;
                    Chip {
                        y: 5px;
                        label: "All " + root.counts-all;
                        active: root.active-filter == "all";
                        clicked => { root.set-filter("all"); }
                    }
                    Chip {
                        y: 5px;
                        label: "★ " + root.counts-picked;
                        active: root.active-filter == "picked";
                        clicked => { root.set-filter("picked"); }
                    }
                    Chip {
                        y: 5px;
                        label: "✕ " + root.counts-rejected;
                        active: root.active-filter == "rejected";
                        clicked => { root.set-filter("rejected"); }
                    }
                    Chip {
                        y: 5px;
                        label: "Unmarked " + root.counts-unmarked;
                        active: root.active-filter == "unmarked";
                        clicked => { root.set-filter("unmarked"); }
                    }
                    Chip {
                        y: 5px;
                        label: root.sort-label;
                        active: false;
                        clicked => { root.cycle-sort(); }
                    }
                }
            }

            flick := Flickable {
                // Explicit x: Slint CENTERS an element whose width is bound
                // but whose x is not (issue #12: the panel toggle shifted
                // the grid right by panel-w/2, half of it under the panel).
                //
                // grid-width/grid-height ARE this rectangle (see their
                // declarations): the Rust layout math and the element it
                // lays out now read the same two expressions.
                x: 0;
                y: root.bar-h;
                width: root.grid-width;
                height: root.grid-height;
                viewport-width: self.width;
                viewport-height: root.virtual-height;
                viewport-y <=> root.vp-y;

                for cell in root.cells: Rectangle {
                    x: cell.x;
                    y: cell.y;
                    width: cell.w;
                    height: cell.h;
                    // Spec: real folders get neutral gray placeholders; the
                    // hue tint is only for --synthetic cells (seed >= 0).
                    background: cell.has-image ? #000000
                        : cell.seed < 0 ? #2a2a2e
                        : hsv(Math.mod(cell.seed * 47, 360), 0.30, 0.22);

                    if cell.has-image: Image {
                        source: cell.image;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                    cell-ta := TouchArea {
                        property <bool> mod-ctrl: false;
                        property <bool> mod-shift: false;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                self.mod-ctrl = ev.modifiers.control;
                                self.mod-shift = ev.modifiers.shift;
                            }
                        }
                        clicked => {
                            root.cell-clicked(
                                cell.id, self.pressed-x, self.pressed-y,
                                self.mod-ctrl, self.mod-shift);
                            root.dbg-focus-claim("cell-click");
                            keys.focus(); // clicking the grid claims the keyboard
                            root.focus-owner = 0; // #63: record the claim now, not a tick later
                        }
                        // Grid double-click opens the loupe at fit (issue
                        // #11; the first click already moved the cursor).
                        double-clicked => { root.cell-double-clicked(cell.id); }
                    }
                    if !cell.has-image: Text {
                        text: cell.label;
                        color: #808088;
                        font-size: 11px;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // Rejected: dim the cell (rendered above the image).
                    if cell.pick == 2: Rectangle {
                        background: #000000;
                        opacity: 0.4;
                    }
                    // Selection wash: a translucent accent-blue tint over the
                    // whole selected cell. The 2px outline below is nearly
                    // invisible at 12 columns, so a multi-selection could not
                    // be read at a glance; the wash is what carries "these are
                    // the images the IPTC panel will stamp" (the selection's
                    // only batch consumer — marks are cursor-only by design).
                    // Painted above the image but BELOW the badges so ★/✕/×N/✓
                    // stay crisp, and it deliberately includes the cursor cell:
                    // per Selection::batch the cursor is in the batch only if
                    // it is itself selected, so that is the one cell whose
                    // membership is ambiguous. Its 3px border still marks it.
                    // GRID ONLY: never tint the loupe (persona: "in the loupe
                    // I am judging pixels"). at-fit/one2one are the loupe
                    // states; the multi-image grid is everything else.
                    if cell.selected && !root.at-fit && !root.one2one: Rectangle {
                        background: root.selection-wash.with-alpha(
                            root.selection-wash-opacity);
                    }
                    // Pick badges (above image, below cursor border).
                    if cell.pick == 1: Text {
                        text: "★";
                        color: #ffd24d;
                        font-size: 20px;
                        x: 8px;
                        y: 4px;
                    }
                    if cell.pick == 2: Text {
                        text: "✕";
                        color: #ff5a5a;
                        font-size: 18px;
                        x: 8px;
                        y: 4px;
                    }
                    // Selection outline (Visual language: accent outline;
                    // thinner + dimmer than the cursor so both read).
                    if cell.selected && !cell.is-cursor: Rectangle {
                        border-width: 2px;
                        border-color: #3a6ea5;
                        background: transparent;
                    }
                    // Burst badge (M7): boundary marker + depth gauge on
                    // the group's first frame ("×23"); bottom-right, away
                    // from the pick badge corner (burst-grouping.md).
                    if cell.burst-count > 0: Rectangle {
                        x: parent.width - t-burst.preferred-width - 14px;
                        y: parent.height - 22px;
                        width: t-burst.preferred-width + 10px;
                        height: 18px;
                        border-radius: 4px;
                        background: #202028cc;
                        t-burst := Text {
                            text: "×" + cell.burst-count;
                            color: #d8d8e0;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    // Copied badge (M6): the session's "this one is safe
                    // at the destination" mark.
                    if cell.copied: Text {
                        text: "✓";
                        color: #6ade8a;
                        font-size: 16px;
                        x: 8px;
                        y: parent.height - 24px;
                    }
                    // Exported-as-video badge (#56): bottom-left beside ✓,
                    // stepping right when the ✓ is there so the two never
                    // overlap; the ×N pill keeps the bottom-right.
                    //
                    // Deliberately NOT ✓'s green: green means "your files
                    // are safe at the destination", a data-safety signal,
                    // and this is not one. The ×N pill's palette instead —
                    // a thirty-cell run of exported rejects has to read
                    // quiet, and a bare glyph would wash out under the
                    // 40 % reject dim these frames usually wear.
                    if cell.exported: Rectangle {
                        x: cell.copied ? 28px : 8px;
                        y: parent.height - 22px;
                        width: t-exp.preferred-width + 10px;
                        height: 18px;
                        border-radius: 4px;
                        background: #202028cc;
                        t-exp := Text {
                            text: "▶";
                            color: #d8d8e0;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                    // Cursor overlay: LAST child = rendered on top of the image
                    // (spec: the selector must be visible on every cell state).
                    if cell.is-cursor: Rectangle {
                        border-width: 3px;
                        border-color: #4da3ff;
                        background: transparent;
                    }
                    if cell.failed: Rectangle {
                        x: parent.width - 22px;
                        y: 4px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #c03030;
                        Text {
                            text: "!";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            // Fit-state pointer surface (issue #11): at loupe fit the
            // wheel ZOOMS one ladder stop (it no longer browses images —
            // user decision; movement inside the loupe is keyboard-only),
            // a click does nothing but claim keyboard focus (whole image
            // on screen, spec Q5), a double-click goes to 1:1 on the
            // clicked point, a drag is inert (no pan axis at fit).
            // Permanent + visibility-toggled (issue #6 rule); declared
            // BEFORE the scrollbar so the bar stays on top and draggable.
            fit-ta := TouchArea {
                visible: root.at-fit;
                x: 0;
                y: root.bar-h;
                width: root.grid-width;
                height: root.grid-height;
                fit-wheel := WheelNotches { }
                scroll-event(e) => {
                    if (e.delta-y == 0) {
                        return reject;
                    }
                    if (fit-wheel.feed(e.delta-y) != 0) {
                        root.pointer-wheel(fit-wheel.last > 0, e.modifiers.control,
                            self.mouse-x, self.mouse-y + root.bar-h);
                    }
                    return accept;
                }
                clicked => {
                    // Click at fit does nothing to the view (spec Q5) — it
                    // only claims the cursor and the keyboard.
                    root.fit-clicked();
                    root.dbg-focus-claim("fit-click");
                    keys.focus();
                    root.focus-owner = 0; // #63: record the claim now, not a tick later
                }
                double-clicked => {
                    root.fit-double-clicked(self.mouse-x, self.mouse-y + root.bar-h);
                }
            }

            // Modern overlay scrollbar (task #21, user request): thin and
            // dim until hovered/dragged, thumb sized by viewport/content,
            // draggable with a position hint. Never moves the cursor
            // (scrolling is browsing — cursor contract).
            if root.virtual-height > flick.height && root.empty-message == "": Rectangle {
                x: flick.x + flick.width - 18px;
                y: flick.y;
                width: 18px; // grab zone wider than the visual (persona)
                height: flick.height;
                background: transparent;
                sb-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    // Wheel over the scrollbar is NOT loupe input (spec);
                    // swallow so it can't fall through to fit-ta and zoom.
                    scroll-event(e) => { return accept; }
                    moved => {
                        if (self.pressed) {
                            root.sb-activity = true;
                            root.vp-y = -clamp(
                                (self.mouse-y - thumb.height / 2)
                                    / max(1px, parent.height - thumb.height)
                                    * (root.virtual-height - flick.height),
                                0px, root.virtual-height - flick.height);
                        }
                    }
                    clicked => {
                        // Track click: jump straight to the spot.
                        root.sb-activity = true;
                        root.vp-y = -clamp(
                            (self.mouse-y - thumb.height / 2)
                                / max(1px, parent.height - thumb.height)
                                * (root.virtual-height - flick.height),
                            0px, root.virtual-height - flick.height);
                    }
                }
                thumb := Rectangle {
                    x: parent.width - self.width - 2px;
                    width: (sb-ta.has-hover || sb-ta.pressed) ? 10px : 6px;
                    border-radius: 5px;
                    height: max(24px, flick.height * flick.height / max(1px, root.virtual-height));
                    y: (-root.vp-y) / max(1px, root.virtual-height - flick.height)
                        * (parent.height - self.height);
                    background: (sb-ta.has-hover || sb-ta.pressed) ? #ffffffcc : #ffffff50;
                    animate width { duration: 100ms; }
                }
                if sb-ta.pressed && root.scroll-hint != "": Rectangle {
                    x: -116px;
                    y: clamp(thumb.y, 0px, parent.height - 24px);
                    width: 110px;
                    height: 22px;
                    border-radius: 4px;
                    background: #202028ee;
                    Text {
                        text: root.scroll-hint;
                        color: #ffffff;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            // Inbox-zero / empty-view state (persona G2): the payoff moment
            // gets a face, not a blank void. Centered in the GRID area,
            // not the window (issue #12: off-centre with the panel open).
            if root.empty-message != "": Rectangle {
                x: 0;
                y: root.bar-h;
                width: root.grid-width;
                height: root.grid-height;
                background: #161618;
                Text {
                    text: root.empty-message;
                    color: #a8a8b0;
                    font-size: 16px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Zoomed loupe overlay (any factor above fit, capped at 1:1): the
        // full-res texture GPU-scaled to loupe-w/h, pannable by drag; a
        // click (press+release without movement past the drag threshold)
        // re-centers on the clicked point (ui-grid.md zoom ladder).
        // ALWAYS instantiated, visibility-toggled — never `if root.one2one`
        // (issue #6): a conditional element is torn down and re-created on
        // every texture gap during held-arrow navigation, and a freshly
        // created element initializes before Rust's offset write lands —
        // one frame at 0,0 per transition, a visible top-left stream at
        // 20 fps culling. An invisible element is neither rendered nor
        // hit-tested, so the grid beneath keeps its input when the
        // overlay is down.
        //
        // There is deliberately NO Flickable here (issue #46): a real
        // flick made it install its deceleration binding on the viewport
        // offsets, which SURVIVED programmatic writes — an arrow pressed
        // during the decay rendered the next image at the still-animating
        // offsets (crossing 0,0) and fed them back into the pan centre as
        // phantom drags. The image is positioned directly from
        // loupe-vx/vy, which Rust alone writes; the TouchArea below
        // implements the drag (1:1 with the pointer, stop on release —
        // the pointer contract never promised inertia).
        Rectangle {
            visible: root.one2one;
            // Overlay covers the GRID area, not the window: with the IPTC
            // panel open the loupe must not extend under it (issue #12 —
            // Rust sizes the image from grid-width, so a full-window
            // overlay showed the same panel-w/2 gutter). x/y explicit for
            // the missing-binding trap.
            x: 0;
            y: 0;
            width: root.grid-width;
            // NOT grid-height: the overlay starts at y 0, above the filter
            // bar, so its height is the loupe area (which is exactly
            // `content.height - statusbar.height`, see loupe-area-h) —
            // the one quantity of the three that legitimately differs.
            height: root.loupe-area-h;
            background: #000000;
            clip: true;
            zoomed-img := Image {
                source: root.loupe-image;
                // Centering term for an extent smaller than the viewport
                // (offset_centering returns 0 there), plus the pan offset
                // (<= 0) — the same geometry the Flickable composed from
                // its content x and viewport-x.
                x: max(0px, (parent.width - root.loupe-w) / 2) + root.loupe-vx;
                y: max(0px, (parent.height - root.loupe-h) / 2) + root.loupe-vy;
                width: root.loupe-w;
                height: root.loupe-h;
            }
            TouchArea {
                zoom-wheel := WheelNotches { }
                // Drag state: `dragging` latches once the pointer travels
                // past the threshold while pressed (Slint's Flickable used
                // 8 logical px — keep the feel), and suppresses the
                // click/double-click of that release ("drag beats click").
                // Reset on the next press, never on release: `clicked`
                // fires at release time and must still see it.
                property <bool> dragging: false;
                property <length> drag-dx: 0;
                property <length> drag-dy: 0;
                x: zoomed-img.x;
                y: zoomed-img.y;
                width: zoomed-img.width;
                height: zoomed-img.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.dragging = false;
                    }
                }
                moved => {
                    // Drag-pan, 1:1 with pointer motion (pointer
                    // contract). Rust is the ONLY writer of loupe-vx/vy:
                    // the callback folds the delta through the pointer
                    // machine's Zoomed×Drag row and rewrites the offsets
                    // synchronously, so this content-space touch area has
                    // already moved with the image when the next event's
                    // coordinates are computed — mouse-x - pressed-x is
                    // therefore the UN-APPLIED residual since the press:
                    // deltas never double-apply, motion spent against the
                    // pan clamp stays in the residual (absolute
                    // grab-point behavior), and the below-threshold
                    // prefix of a drag is recovered in full by the first
                    // applied event.
                    self.drag-dx = self.mouse-x - self.pressed-x;
                    self.drag-dy = self.mouse-y - self.pressed-y;
                    if (!self.dragging && abs(self.drag-dx) + abs(self.drag-dy) > 8px) {
                        self.dragging = true;
                    }
                    if (self.dragging) {
                        root.loupe-dragged(self.drag-dx / 1px, self.drag-dy / 1px);
                    }
                }
                clicked => {
                    if (!self.dragging) {
                        root.loupe-clicked(
                            self.pressed-x / max(1px, self.width),
                            self.pressed-y / max(1px, self.height));
                        root.dbg-focus-claim("overlay-click");
                        // Focus claim, same as the grid-cell and fit
                        // surfaces (issue #41 defense in depth): at 1:1
                        // this was the ONE click surface that did not
                        // claim the keyboard, so a stranded keyboard had
                        // no discoverable recovery in the loupe. Additive
                        // — the click still re-centers exactly as before.
                        keys.focus();
                        root.focus-owner = 0; // #63: record the claim now, not a tick later
                    }
                }
                // Wheel above fit walks the zoom ladder, anchored
                // under the pointer (issue #11 — the wheel no longer
                // pans). Coords are converted to the overlay's view
                // space (zoomed-img.x already carries the pan offset).
                scroll-event(e) => {
                    if (e.delta-y == 0) {
                        return reject;
                    }
                    if (zoom-wheel.feed(e.delta-y) != 0) {
                        root.pointer-wheel(zoom-wheel.last > 0, e.modifiers.control,
                            zoomed-img.x + self.mouse-x,
                            zoomed-img.y + self.mouse-y);
                    }
                    return accept;
                }
                double-clicked => {
                    if (!self.dragging) {
                        root.zoom-double-clicked(
                            zoomed-img.x + self.mouse-x,
                            zoomed-img.y + self.mouse-y);
                    }
                }
            }
            // Loading cue pill (issue #21): VIEWPORT-FIXED — never
            // positioned in panned content space (validator MAJOR on
            // the Flickable-era overlay: a content-space pill sat
            // thousands of px off-screen at zoom; the panning Image is
            // its sibling for the same reason).
            // Permanent element, visibility-toggled (the issue #6/#20
            // rule); pointer-inert (no TouchArea). Sits BELOW the #20
            // state badge slot (top-left, 14px, belongs to the mark —
            // muscle memory from the grid badge corner), stacked so
            // the two never overlap and never entangle their
            // visibility contracts.
            Rectangle {
                visible: root.loupe-soft;
                x: 14px;
                y: 44px;
                width: t-cue.preferred-width + 16px;
                height: 22px;
                border-radius: 6px;
                background: #202028cc;
                t-cue := Text {
                    text: "◌ loading";
                    color: #b8b8c0;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Loupe state badge (issue #20, persona MUST-HAVE): the cursor's
        // mark, visible at fit AND zoomed — one continuous loupe, the
        // state readable without leaving it. Top-LEFT (same corner as
        // the grid badge — muscle memory; top-right stays free for a
        // future histogram). An OVERLAY on its own dark pill (never a
        // reserved strip — the image must not reflow), left-aligned and
        // free to grow to five stars when ratings land. Badge only for
        // picked/rejected — unmarked is absence, backstopped by the
        // status bar spelling the state in words. Pointer-inert; a
        // permanent element, visibility-toggled (issue #6 rule). Note
        // the loupe NEVER dims a reject (deliberate divergence from the
        // grid's 40% dim — rescue judging needs full brightness); at
        // N=1 Rust sends cells pick=0 so the grid dim cannot leak in.
        // Declared after the 1:1 overlay: draws above both loupe forms.
        Rectangle {
            visible: (root.one2one || root.at-fit) && root.loupe-mark != 0;
            x: 14px;
            y: root.one2one ? 14px : root.bar-h + 14px;
            width: t-badge.preferred-width + 16px;
            height: 24px;
            border-radius: 6px;
            background: #202028cc;
            t-badge := Text {
                text: root.loupe-mark == 1 ? "★" : "✕";
                color: root.loupe-mark == 1 ? #ffd24d : #ff5a5a;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // IPTC panel (M5, iptc-templates.md + persona G3-G7): docked right,
        // toggled by I; K focuses the keyword field. Field editors own the
        // keyboard while focused (focus containment: typing "Xavier" must
        // not reject a photo — LineEdit focus keeps events out of `keys`).
        if root.iptc-visible: Rectangle {
            x: parent.width - root.panel-w;
            y: 0;
            width: root.panel-w;
            height: parent.height - statusbar.height;
            background: #1c1c20;
            border-width: 1px;
            border-color: #2c2c30;
            // Click containment (issue #12): a click on panel whitespace
            // must never reach the grid (it would move the cursor and
            // collapse a multi-selection mid-keywording). First child =
            // painted under the fields, so editors still get their events.
            TouchArea { }
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: root.iptc-batch-label;
                    color: #a8a8b0;
                    font-size: 12px;
                }
                if root.iptc-warning != "": Text {
                    text: root.iptc-warning;
                    color: #ffb84d;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                // Template row (G5): dropdown + Apply + single-level revert.
                HorizontalLayout {
                    spacing: 6px;
                    tplbox := ComboBox {
                        model: root.iptc-templates;
                        enabled: root.iptc-templates.length > 0;
                    }
                    Button {
                        text: "Apply";
                        enabled: root.iptc-templates.length > 0;
                        clicked => {
                            root.iptc-apply-template(max(tplbox.current-index, 0));
                            root.dbg-focus-claim("template-apply");
                            keys.focus();
                            root.focus-owner = 0; // #63: record the claim now, not a tick later
                        }
                    }
                }
                Button {
                    text: root.iptc-revert-label == "" ? "Revert last apply" : root.iptc-revert-label;
                    enabled: root.iptc-revert-enabled;
                    clicked => {
                        root.iptc-revert();
                        root.dbg-focus-claim("revert");
                        keys.focus();
                        root.focus-owner = 0; // #63: record the claim now, not a tick later
                    }
                }
                // Field rows: LineEdit + tri-state affordance. state 0 =
                // untouched (grayed placeholder), 1 = value, 2 = CLEAR badge.
                Flickable {
                    viewport-height: fields-col.preferred-height;
                    fields-col := VerticalLayout {
                        spacing: 4px;
                        for row[i] in root.iptc-fields: VerticalLayout {
                            spacing: 1px;
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: row.label;
                                    color: #808088;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Rectangle { } // spacer
                                TouchArea {
                                    width: 14px;
                                    height: 14px;
                                    Text {
                                        text: "⌫";
                                        color: #707078;
                                        font-size: 11px;
                                    }
                                    clicked => {
                                        root.iptc-field-clear(i);
                                        root.dbg-focus-claim("field-clear");
                                        keys.focus();
                                        root.focus-owner = 0; // #63: record the claim now, not a tick later
                                    }
                                }
                            }
                            fld := LineEdit {
                                text: row.mixed ? "" : row.value;
                                placeholder-text: row.mixed ? "‹multiple values›" : "";
                                font-size: 12px;
                                height: 26px;
                                // Harness observability only (issues
                                // #13/#61) — the row announces where the
                                // layout put it, so a driven click can
                                // wait for it and prove it hit. BOTH
                                // hooks, and neither is redundant: `init`
                                // runs when the conditional panel's items
                                // are instantiated, which is the moment
                                // the row becomes hit-testable at all
                                // (the property is set synchronously, the
                                // item tree catches up in the next
                                // layout pass — that gap IS the flake);
                                // `changed` catches the rows a second
                                // layout pass moves afterwards, which is
                                // most of them but measurably not rows 0
                                // and 1, whose first computed position is
                                // already their last.
                                init => {
                                    // BEFORE `settled` below: the claim is
                                    // gated on this stamp (#63 FAIL-1).
                                    self.born-gen = root.iptc-rebuild-gen;
                                    root.dbg-field-laid-out(i,
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width, self.height);
                                    // NO focus() here, deliberately (#63
                                    // FAIL-1): `self.focus()` from a
                                    // repeater row's `init` does not take
                                    // effect in Slint 1.17, it silently
                                    // does nothing. What this does instead
                                    // is give `want-refocus` an EDGE to
                                    // fire on — see `settled`.
                                    self.settled = true;
                                }
                                // The edge that makes an EARLY arm land
                                // (#63, QE 2026-08-30). A zero-length arm
                                // timer can fire before the repeater has
                                // recreated this row; the flag is then
                                // already set when the row is born, so
                                // `want-refocus` is true from its first
                                // evaluation and `changed` never fires —
                                // the request was armed, matched, and
                                // silently never claimed (3 runs in 20
                                // under six spinners, ownerless for good).
                                // Assigning `settled` in `init` moves the
                                // property from false to true AFTER
                                // creation, so the edge exists and the
                                // claim happens from a `changed` handler,
                                // on a row that is alive and can focus.
                                // The flag itself is cleared ONLY by an
                                // actual claim, so an early arm survives
                                // until its row exists to answer it.
                                property <bool> settled: false;
                                // The laid-out belt for the same request:
                                // if the flag was armed before this row
                                // could watch it (a timer beating the
                                // repeater update), `changed want-refocus`
                                // never fires, because the value was
                                // already true at creation. This handler
                                // does fire — the layout places the row
                                // after it exists — and by then focusing
                                // works.
                                changed absolute-position => {
                                    root.dbg-field-laid-out(i,
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width, self.height);
                                    if (self.want-refocus) { self.claim-refocus(); }
                                }
                                accepted(text) => {
                                    root.iptc-field-committed(i, text, true);
                                    root.dbg-focus-claim("field-accepted");
                                    keys.focus(); // G4: Enter returns to grid, cursor stays
                                    root.focus-owner = 0; // #63: record the claim now, not a tick later
                                }
                                property <int> edit-gen: -1;
                                // The item-tree generation this edit
                                // belongs to (#63 F2, see
                                // iptc-rebuild-gen): stamped wherever
                                // edit-gen is, checked by the blur.
                                property <int> edit-rebuild: -1;
                                // Session swap: in-flight text belongs to
                                // the OLD session — re-sync to the (new)
                                // stored value immediately (#41 D3),
                                // independent of when the blur lands.
                                property <int> seen-gen: root.session-gen;
                                changed seen-gen => {
                                    self.text = row.mixed ? "" : row.value;
                                }
                                // The keyboard coming BACK to this row
                                // after a rebuild destroyed its previous
                                // instance (#63 F3). Both arms, for the
                                // reason `kwedit` documents below: `init`
                                // is the one that fires when the repeater
                                // recreates this row, and it fires no
                                // `changed has-focus`, so the stamps and
                                // the owner token are written HERE.
                                // Which item-tree generation THIS instance
                                // was created for (#63 FAIL-1). Stamped in
                                // `init`, so the doomed instance keeps the
                                // old value and can never consume a flag
                                // armed for the rebuild that kills it.
                                property <int> born-gen: -1;
                                property <bool> want-refocus: self.settled
                                    && root.iptc-refocus-row == i && root.iptc-refocus-gen == self.born-gen;
                                function claim-refocus() {
                                    root.dbg-focus-claim("row " + i + " (gen " + self.born-gen + ")");
                                    self.focus();
                                    self.edit-gen = root.session-gen;
                                    self.edit-rebuild = root.iptc-rebuild-gen;
                                    root.focus-owner = i + 1;
                                    root.iptc-refocus-row = -1;
                                }
                                changed want-refocus => {
                                    if (self.want-refocus) { self.claim-refocus(); }
                                }
                                changed has-focus => {
                                    root.dbg-focus-changed("iptc field " + i, self.has-focus);
                                    if (self.has-focus) {
                                        // Stamp the session this edit
                                        // belongs to (#41 D3, see
                                        // session-gen).
                                        self.edit-gen = root.session-gen;
                                        self.edit-rebuild = root.iptc-rebuild-gen;
                                        // Claim the owner token (#63):
                                        // this editor dies with the next
                                        // rows-model replacement, and
                                        // the token is what tells Rust
                                        // the keyboard needs rescuing —
                                        // and which row to give it back
                                        // to.
                                        root.focus-owner = i + 1;
                                        if (root.about-visible || root.shortcuts-visible || root.copy-visible || root.clip-visible) {
                                            // Focus continuity (#41 D2):
                                            // an editor must never hold
                                            // the keyboard behind a
                                            // covering surface — the
                                            // menu's post-activation
                                            // focus restore lands here,
                                            // and this bounce hands it
                                            // straight to the covering
                                            // scope, synchronously.
                                            // focus-keys routes: keys
                                            // for the modals, the copy
                                            // dialog's own scope when
                                            // the dialog covers (gate
                                            // finding: File > Copy
                                            // Picks over a focused
                                            // field held only by
                                            // init-timing luck).
                                            root.dbg-focus-claim("bounce (field behind a cover)");
                                            root.focus-keys();
                                        }
                                    } else if (root.iptc-visible && self.edit-gen == root.session-gen && self.edit-rebuild == root.iptc-rebuild-gen && self.text != row.value) {
                                        // G7: click-away from a half-typed
                                        // field COMMITS (no focus return);
                                        // a modal covering the field exits
                                        // it the same way. The Rust side
                                        // no-ops when the value is
                                        // unchanged, so Enter's focus hop
                                        // does not double-commit. Gated on
                                        // iptc-visible AND the session
                                        // stamp: focus lost because the
                                        // panel is being destroyed OR the
                                        // session was swapped DISCARDS the
                                        // un-committed text (#41 D1/D3,
                                        // user decision — no
                                        // commit-on-destroy).
                                        root.iptc-field-committed(i, self.text, false);
                                        // Re-sync the display: if the commit
                                        // no-opped (emptied or padded text),
                                        // the model kept the old value — the
                                        // editor must not keep showing a
                                        // value that was never stored (QE).
                                        self.text = row.mixed ? "" : row.value;
                                    } else {
                                        // Discarded exit: show the stored
                                        // value, never the abandoned text.
                                        self.text = row.mixed ? "" : row.value;
                                    }
                                }
                            }
                        }
                    }
                }
                // Keywords: chips with X (append-only entry below).
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for chip[i] in root.iptc-keywords: Rectangle {
                        height: 20px;
                        width: chip-t.preferred-width + 26px;
                        border-radius: 10px;
                        background: #2c3c50;
                        chip-t := Text {
                            x: 6px;
                            text: chip.coverage == "" ? chip.text : chip.text + " " + chip.coverage;
                            color: #c8d8e8;
                            font-size: 11px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                        TouchArea {
                            x: parent.width - 16px;
                            width: 14px;
                            height: 100%;
                            Text {
                                text: "×";
                                color: #8898a8;
                                font-size: 12px;
                                vertical-alignment: center;
                                height: 100%;
                            }
                            clicked => {
                                root.iptc-keyword-removed(i);
                                root.dbg-focus-claim("keyword-removed");
                                keys.focus();
                                root.focus-owner = 0; // #63: record the claim now, not a tick later
                            }
                        }
                    }
                }
                kwedit := LineEdit {
                    // K lands here: on panel open (init) or while already
                    // open (the watch property observes the root flag).
                    // Each programmatic gain stamps edit-gen ITSELF:
                    // `changed has-focus` does not fire for a focus gain
                    // made during init, so relying on it alone left the
                    // stamp stale and the blur path silently DISCARDED
                    // committable text (found while verifying #41).
                    property <bool> want-focus: root.iptc-focus-keywords;
                    // The owner token is written HERE and not left to
                    // `changed has-focus` (issue #63 F5): a focus gain made
                    // during `init` fires no change handler at all, the
                    // same Slint behaviour `edit-gen` above works around.
                    // Leaving it out is what made the `K` flow read
                    // `focus-owner == 0` while this editor held the
                    // keyboard.
                    function claim-keywords() {
                        self.focus();
                        self.edit-gen = root.session-gen;
                        root.focus-owner = root.iptc-fields.length + 1;
                        root.iptc-focus-keywords = false;
                    }
                    init => {
                        root.dbg-note("iptc keyword field created");
                        if (self.want-focus) {
                            root.dbg-focus-claim("keyword-init");
                            self.claim-keywords();
                        }
                    }
                    changed want-focus => {
                        if (self.want-focus) {
                            root.dbg-focus-claim("keyword-watch");
                            self.claim-keywords();
                        }
                    }
                    // Session swap while this editor holds text: the text
                    // belongs to the OLD session — discard it immediately
                    // (#41 D3, user decision), independent of when the
                    // blur lands.
                    property <int> seen-gen: root.session-gen;
                    changed seen-gen => { self.text = ""; }
                    placeholder-text: "add keywords, comma-separated";
                    font-size: 12px;
                    height: 26px;
                    accepted(text) => {
                        root.iptc-keyword-added(text);
                        self.text = "";
                        root.dbg-focus-claim("keyword-accepted");
                        keys.focus(); // G4: commit returns to grid
                        root.focus-owner = 0; // #63: record the claim now, not a tick later
                    }
                    property <int> edit-gen: -1;
                    changed has-focus => {
                        root.dbg-focus-changed("keyword field", self.has-focus);
                        if (self.has-focus) {
                            // Session stamp (#41 D3, see session-gen).
                            self.edit-gen = root.session-gen;
                            // Owner token (#63/#64), one past the last
                            // field row. This editor outlives a rows
                            // rebuild — it is not inside that model, which
                            // is why it carries no `edit-rebuild` stamp —
                            // but it dies with the panel, and the token
                            // has to name it either way.
                            root.focus-owner = root.iptc-fields.length + 1;
                            if (root.about-visible || root.shortcuts-visible || root.copy-visible || root.clip-visible) {
                                // Focus continuity (#41 D2): bounce a
                                // focus gain that arrives behind a
                                // covering surface — same rule and
                                // routing as the field rows above.
                                root.dbg-focus-claim("bounce (keyword behind a cover)");
                                root.focus-keys();
                            }
                        } else if (root.iptc-visible && self.edit-gen == root.session-gen && self.text != "") {
                            // G7 click-away commits; panel destruction or
                            // a session swap DISCARDS (#41 D1/D3 — the
                            // iptc-visible gate and the session stamp).
                            root.iptc-keyword-added(self.text);
                            self.text = "";
                        } else {
                            self.text = ""; // discarded exit
                        }
                    }
                }
                Rectangle { } // bottom spacer
            }
        }

        // Copy Picks dialog (M6, fileops.md): modal; Ctrl+E, glance,
        // Enter is the whole feature. The remembered destination is
        // displayed PROMINENTLY (the yesterday's-job failure mode).
        //
        // KNOWN RESIDUAL (gate finding, re-asked by a later review): this
        // is a third hand-rolled copy of the ModalScrim scaffolding, and it
        // stays hand-rolled because the difference is FUNCTIONAL, not
        // cosmetic — adopting the component would move key handling, which
        // this pass is not allowed to do.
        //
        //   * `copy-keys` is a FocusScope that must be an ANCESTOR of the
        //     whole dialog: key events bubble only up the focused element's
        //     ancestor chain, and this dialog moves focus into its own
        //     children (Choose…, the rename field, Copy). As a sibling,
        //     Enter/Esc died inside whichever child last held focus (PR #43
        //     focus continuity, issue #42 containment). A ModalScrim child
        //     lands INSIDE the card's VerticalLayout via `@children`, i.e.
        //     a descendant of the card — the one place this scope cannot
        //     be.
        //   * the scrim TouchArea here swallows clicks WITHOUT dismissing;
        //     ModalScrim's calls `dismissed()`. That one IS expressible
        //     (bind `dismissed => { }`), so it is not the blocker.
        //
        // The card width was the accidental half of the gap and is a
        // property now (57c225c); what is left needs ModalScrim to take the
        // focus scope as a WRAPPER rather than a child — a component-API
        // change with focus behavior riding on it, which belongs in its own
        // PR, not in a behavior-preserving dedup.
        if root.copy-visible: Rectangle {
            y: 0; // missing-binding trap (issue #12): unset y centered the scrim 13px low
            width: 100%;
            height: parent.height - statusbar.height;
            background: #000000aa;
            TouchArea {
                // Clicks are swallowed WITHOUT dismissing (unlike
                // ModalScrim): this dialog closes on Esc or Cancel only.
                // The wheel is swallowed too (issue #49) — an unhandled
                // scroll falls through to the grid's Flickable behind the
                // scrim, and a modal that scrolls the grid underneath
                // loses the user's place mid-cull.
                scroll-event(e) => { return accept; }
            }
            copy-keys := FocusScope {
                // ANCESTOR of the whole dialog (gate finding: as a 0x0
                // sibling, Enter/Esc died inside whichever child last
                // held focus — key events only bubble up the focused
                // element's ancestor chain).
                width: 100%;
                height: 100%;
                // Owner token (#63): a dialog scope is -1, which no
                // rebuild reclaim ever matches — while this dialog is up
                // the keyboard is ITS business, and a panel rebuild
                // underneath must not pull focus out of it.
                changed has-focus => {
                    root.dbg-focus-changed("copy dialog", self.has-focus);
                    if (self.has-focus) { root.focus-owner = -1; }
                }
                // Move the report body by `dy`, clamped to what there is
                // to see. `viewport-y` is 0 at the top and negative going
                // down; the floor is `height - viewport-height`, which is
                // 0 when nothing overflows, so an over-large step lands on
                // the last line instead of scrolling into blank space.
                function scroll-copy-body(dy: length) {
                    copy-body.viewport-y = clamp(copy-body.viewport-y + dy,
                        min(0px, copy-body.height - copy-body.viewport-height), 0px);
                }
                key-pressed(event) => {
                    // Modal containment, topmost-first (issue #42): About
                    // or the shortcuts popup can open OVER this dialog
                    // (the menu bar stays live), and focus lives in THIS
                    // scope then. Esc must close the popup on top — the
                    // old code let it act on the hidden dialog underneath,
                    // discarding the destination/plan state while About
                    // stayed up. Every other key is swallowed (the same
                    // "swallow everything in that screen" rule as `keys`),
                    // which also keeps N-containment intact here.
                    if (root.about-visible || root.shortcuts-visible) {
                        if (event.text == Key.Escape) {
                            if (root.about-visible) {
                                root.about-visible = false;
                            } else {
                                root.shortcuts-visible = false;
                            }
                        }
                        return accept;
                    }
                    // THE BODY SCROLLS FROM THE KEYBOARD TOO (issue #62).
                    // Only while it actually overflows: below that these
                    // keys keep the meaning they have today (swallowed by
                    // the question, or rejected), and B/O/Esc/Enter are
                    // never in this set. This is a keyboard-first app —
                    // a report the mouse can reach and the keyboard
                    // cannot is not a report the user can read.
                    if (copy-body.viewport-height > copy-body.height) {
                        if (event.text == Key.DownArrow) {
                            self.scroll-copy-body(-40px);
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            self.scroll-copy-body(40px);
                            return accept;
                        }
                        if (event.text == Key.PageDown) {
                            self.scroll-copy-body(-copy-body.height);
                            return accept;
                        }
                        if (event.text == Key.PageUp) {
                            self.scroll-copy-body(copy-body.height);
                            return accept;
                        }
                        if (event.text == Key.Home) {
                            self.scroll-copy-body(copy-body.viewport-height);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.scroll-copy-body(-copy-body.viewport-height);
                            return accept;
                        }
                    }
                    // The clash question owns every key while it is up
                    // (fileops.md: the destructive answer must not sit on
                    // Y, N or Enter). Esc cancels the question and returns
                    // to the plan — a SECOND Esc closes the dialog, so the
                    // destination and template survive a mis-typed key.
                    if (root.copy-state == 3) {
                        if (event.text == Key.Escape) {
                            root.copy-answer-cancel();
                            return accept;
                        }
                        // BARE letters only. Ctrl+O is Open Folder, and on
                        // some layouts AltGr produces letters too — but
                        // every one of them arrives here as the plain
                        // letter PLUS a modifier, so without this guard the
                        // Open Folder reflex ANSWERS the question, and the
                        // answer it gives is the destructive one (gate
                        // finding 2026-08-21). Shift is fine: "O" is
                        // matched as well.
                        if (!event.modifiers.control && !event.modifiers.alt
                            && !event.modifiers.meta) {
                            if (event.text == "b" || event.text == "B") {
                                root.copy-answer-keep-both();
                                return accept;
                            }
                            if (event.text == "o" || event.text == "O") {
                                root.copy-answer-overwrite();
                                return accept;
                            }
                        }
                        // Enter, Space, Y, N, everything: swallowed, and
                        // the question says out loud that it is waiting.
                        root.copy-confirm-nudged = true;
                        return accept;
                    }
                    if (event.text == Key.Escape && root.copy-state != 1) {
                        root.copy-close();
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        if (root.copy-state == 0 && root.copy-ready) {
                            root.copy-start();
                            return accept;
                        }
                        if (root.copy-state == 2) {
                            root.copy-close();
                            return accept;
                        }
                    }
                    reject
                }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 560px;
                // Content-driven between the old constant as a FLOOR and
                // the window, for the reason the export card carries
                // (issue #62). This card's unbounded text is the report:
                // `report_lines` prints one `FAILED name: reason` line per
                // file that failed, so a destination that goes read-only
                // mid-run words itself as long as the run was.
                height: clamp(
                    copy-card-layout.preferred-height,
                    min(480px, parent.height - 40px),
                    parent.height - 40px);
                border-radius: 8px;
                background: #202028;
                border-width: 1px;
                border-color: #3a3a44;
                init => {
                    root.dbg-card-laid-out("copy card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                changed absolute-position => {
                    root.dbg-card-laid-out("copy card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                changed height => {
                    root.dbg-card-laid-out("copy card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                copy-card-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: "Copy Picks";
                        color: #ffffff;
                        font-size: 16px;
                    }
                    // Destination, big and unmissable.
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            background: #16161a;
                            border-radius: 4px;
                            height: 34px;
                            Text {
                                x: 10px;
                                text: root.copy-dest == "" ? "No destination chosen" : root.copy-dest;
                                color: root.copy-dest == "" ? #b06060 : #e8e8f0;
                                font-size: 14px;
                                vertical-alignment: center;
                                height: 100%;
                                overflow: elide;
                                width: parent.width - 20px;
                            }
                        }
                        Button {
                            text: "Choose…";
                            enabled: root.copy-state == 0;
                            clicked => {
                                root.copy-pick-dest();
                                copy-keys.focus();
                            }
                        }
                    }
                    // Rename template: EMPTY = keep original names.
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Rename:";
                            color: #808088;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.copy-template;
                            placeholder-text: "empty = keep original names   e.g. {date}_{seq}.{ext}";
                            font-size: 12px;
                            height: 28px;
                            enabled: root.copy-state == 0;
                            changed has-focus => {
                                // Focus continuity (#41 D2 class): if a
                                // modal opens over the dialog while this
                                // field is focused, the field must not
                                // keep eating keys behind the scrim —
                                // bounce to the dialog's scope, whose
                                // containment branch handles the modal.
                                if (self.has-focus && (root.about-visible || root.shortcuts-visible)) {
                                    copy-keys.focus();
                                }
                            }
                            edited => { root.copy-replan(); }
                            accepted(text) => {
                                // Enter in the field: commit the replan and
                                // hand keys back to the dialog scope so the
                                // NEXT Enter fires Copy (gate finding).
                                root.copy-replan();
                                copy-keys.focus();
                            }
                        }
                        // PLAN STATE ONLY. Its two siblings are already
                        // `enabled: copy-state == 0`; this one had no guard,
                        // so it could be clicked WHILE THE QUESTION WAS UP —
                        // replanning under it and leaving the counts, the
                        // example names, the keep-both name and the byte
                        // cost describing the old template while the answer
                        // executed the new one. The mouse analogue of the
                        // Ctrl+O finding (gate finding 2026-08-22).
                        if root.copy-state == 0 && root.copy-last-template != "" && root.copy-template == "": Chip {
                            label: "Use last: " + root.copy-last-template;
                            active: false;
                            clicked => {
                                root.copy-template = root.copy-last-template;
                                root.copy-replan();
                                copy-keys.focus();
                            }
                        }
                    }
                    // THE GROWING TEXT LIVES HERE, and it SCROLLS instead of
                    // pushing the button row out of the card (issue #62). The card
                    // grows to fit this body up to the window; past that the body
                    // is the only row the layout can shrink (`vertical-stretch`,
                    // no min-height of its own — the header rows and the button
                    // row cannot give up a pixel), so the deficit lands here and
                    // the content scrolls. Nothing is ever truncated, and the
                    // buttons stay inside the card wherever the ceiling can
                    // still hold the fixed rows above and below it (~300px of
                    // window height — video-export.md records the measurement
                    // and the case below it).
                    //
                    // `preferred-height` is the content's, so the CARD's
                    // content-driven height above counts this region at full size
                    // until the ceiling; `viewport-width` is pinned to the view's
                    // own width so nothing ever scrolls sideways. A ScrollView
                    // rather than a bare Flickable: it scrolls the same way and
                    // its scrollbar is the only thing that says a report was cut
                    // off at the ceiling (the clip is line-aligned, so without one
                    // a truncated list looks complete).
                    copy-body := ScrollView {
                        vertical-stretch: 1;
                        min-height: 0px;
                        changed viewport-y => {
                            root.dbg-body-scrolled("copy body", self.viewport-y);
                        }
                        preferred-height: copy-body-content.preferred-height;
                        viewport-width: self.width;
                        viewport-height: copy-body-content.preferred-height;
                        copy-body-content := VerticalLayout {
                            spacing: 10px;
                            if root.copy-preview != "": Text {
                                text: root.copy-preview;
                                color: #9898a8;
                                font-size: 11px;
                            }
                            Text {
                                text: root.copy-summary;
                                color: #c8c8d0;
                                font-size: 13px;
                            }
                            // Plan-preview state only: "Copy will ask what to do"
                            // read as a promise ABOUT THE FUTURE while the copy was
                            // running, and sat above the final report on the one
                            // screen where the user decides whether to trust what
                            // just happened to their files (gate finding).
                            if root.copy-collisions != "" && root.copy-state == 0: Text {
                                text: root.copy-collisions;
                                color: #ffb84d;
                                font-size: 12px;
                                // Three notes can share this line ("2 will be
                                // renamed · 1 sidecars will be refreshed · 1 copied
                                // earlier but gone…"): unwrapped, the part that
                                // matters most was clipped at the dialog edge (QE).
                                wrap: word-wrap;
                            }
                            // THE CLASH QUESTION (copy-state 3). The rows are
                            // stacked, not side by side: three outcome-labelled
                            // answers do not fit across a 560px card (persona
                            // measurement 2026-08-21), and a vertical list reads
                            // as what it is — a menu of three choices, in order of
                            // increasing consequence, with Cancel set apart.
                            if root.copy-state == 3: VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.copy-confirm;
                                    color: #e8e8f0;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if root.copy-confirm-examples != "": Text {
                                    text: root.copy-confirm-examples;
                                    color: #9898a8;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 2px; }
                                AnswerRow {
                                    key: "B";
                                    label: root.copy-confirm-keep-both;
                                    cost: root.copy-confirm-keep-both-cost;
                                    clicked => { root.copy-answer-keep-both(); }
                                }
                                AnswerRow {
                                    key: "O";
                                    label: root.copy-confirm-overwrite;
                                    // The one answer that destroys something wears
                                    // the colour — the BOX never does. A
                                    // primary-styled destructive button gets
                                    // pressed reflexively within a week (persona).
                                    label-color: #ffb84d;
                                    clicked => { root.copy-answer-overwrite(); }
                                }
                                Rectangle { height: 4px; }
                                AnswerRow {
                                    key: "Esc";
                                    label: root.copy-confirm-cancel;
                                    clicked => { root.copy-answer-cancel(); }
                                }
                                if root.copy-confirm-warning != "": Text {
                                    text: root.copy-confirm-warning;
                                    color: #ffb84d;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                if root.copy-confirm-nudged: Text {
                                    text: root.copy-confirm-nudge;
                                    color: #ffb84d;
                                    font-size: 12px;
                                }
                            }
                            if root.copy-error != "": Text {
                                text: root.copy-error;
                                color: #ff7a6a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.copy-state == 1: Text {
                                text: root.copy-progress;
                                color: #c8e8c8;
                                font-size: 13px;
                            }
                            if root.copy-state == 2: Text {
                                text: root.copy-report;
                                color: #c8e8c8;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { } // spring
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        init => {
                            root.dbg-card-laid-out("copy buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        changed absolute-position => {
                            root.dbg-card-laid-out("copy buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        changed height => {
                            root.dbg-card-laid-out("copy buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        if root.copy-state == 2: Button {
                            text: "Open destination";
                            clicked => { root.copy-open-dest-folder(); }
                        }
                        if root.copy-state == 1: Button {
                            text: "Cancel";
                            clicked => { root.copy-cancel(); }
                        }
                        // No Copy button while the question is up: a
                        // greyed fourth control is one more thing to parse
                        // at the moment the user is choosing (persona).
                        if root.copy-state != 1 && root.copy-state != 3: Button {
                            text: root.copy-state == 2 ? "Close" : "Copy";
                            enabled: root.copy-state == 2 || root.copy-ready;
                            clicked => {
                                if (root.copy-state == 2) {
                                    root.copy-close();
                                } else {
                                    root.copy-start();
                                }
                            }
                        }
                    }
                }
            }
            }
            // The init claim also clears any claim flag left from a
            // previous dialog instance, so the watch below can always
            // observe a fresh false→true edge. The owner token is written
            // HERE as well as in `changed has-focus` (issue #63 F5): this
            // gain happens during instantiation and fires no change
            // handler, and without it the token still named a panel field
            // while the dialog held the keyboard — a rebuild underneath
            // the dialog then reclaimed, which is exactly what the -1
            // scope is supposed to forbid.
            init => {
                copy-keys.focus();
                root.focus-owner = -1;
                root.copy-claim-focus = false;
            }
            // Focus routing (issue #41): focus-keys() cannot name a
            // conditional child, so it raises this root flag and the
            // dialog claims its own scope — the same watch pattern as
            // iptc-focus-keywords. This replaces the init-timing LUCK
            // that RUN14 documented (the dialog's init happening to run
            // after the menu's focus restore) with an explicit claim.
            property <bool> claim-focus: root.copy-claim-focus;
            changed claim-focus => {
                if (self.claim-focus) {
                    copy-keys.focus();
                    root.copy-claim-focus = false;
                }
            }
        }

        // EXPORT FRAMES AS VIDEO (M9, video-export.md "Dialog"). The Copy
        // Picks scaffolding, deliberately: same scrim, same key scope as
        // an ANCESTOR of the card (key events bubble only up the focused
        // element's chain), same claim-focus watch, same clash question as
        // a STATE of this dialog rather than a second stacking surface
        // (issue #42). What differs is the content — one file, one plan
        // line, no template field, no options at all.
        //
        // KNOWN RESIDUAL, inherited: this is the fourth hand-rolled scrim
        // rather than a `ModalScrim`, for the reason recorded above the
        // copy dialog — the component takes its children INSIDE the card,
        // and this focus scope has to wrap it.
        if root.clip-visible: Rectangle {
            y: 0;
            width: 100%;
            height: parent.height - statusbar.height;
            background: #000000aa;
            TouchArea {
                // Same contract as the copy scrim: clicks swallowed without
                // dismissing, and the wheel swallowed (issue #49) so the
                // grid's Flickable does not scroll behind the dialog.
                scroll-event(e) => { return accept; }
            }
            clip-keys := FocusScope {
                width: 100%;
                height: 100%;
                // Owner token (#63), same rule as the copy dialog's scope.
                changed has-focus => {
                    root.dbg-focus-changed("clip dialog", self.has-focus);
                    if (self.has-focus) { root.focus-owner = -1; }
                }
                // The export dialog's half of the keyboard scrolling —
                // same contract as `scroll-copy-body` above.
                function scroll-clip-body(dy: length) {
                    clip-body.viewport-y = clamp(clip-body.viewport-y + dy,
                        min(0px, clip-body.height - clip-body.viewport-height), 0px);
                }
                key-pressed(event) => {
                    // Modal containment, topmost first (issue #42): About
                    // or the shortcuts popup can open OVER this dialog,
                    // and focus lives in THIS scope then.
                    if (root.about-visible || root.shortcuts-visible) {
                        if (event.text == Key.Escape) {
                            if (root.about-visible) {
                                root.about-visible = false;
                            } else {
                                root.shortcuts-visible = false;
                            }
                        }
                        return accept;
                    }
                    // The body scrolls from the keyboard too, and only
                    // while it overflows (issue #62 — see the Copy Picks
                    // scope for the reasoning).
                    if (clip-body.viewport-height > clip-body.height) {
                        if (event.text == Key.DownArrow) {
                            self.scroll-clip-body(-40px);
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            self.scroll-clip-body(40px);
                            return accept;
                        }
                        if (event.text == Key.PageDown) {
                            self.scroll-clip-body(-clip-body.height);
                            return accept;
                        }
                        if (event.text == Key.PageUp) {
                            self.scroll-clip-body(clip-body.height);
                            return accept;
                        }
                        if (event.text == Key.Home) {
                            self.scroll-clip-body(clip-body.viewport-height);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.scroll-clip-body(-clip-body.viewport-height);
                            return accept;
                        }
                    }
                    // The clash question owns every key while it is up:
                    // the destructive answer must not sit on Y, N or
                    // Enter, and Ctrl+O (Open Folder) reaches this scope
                    // as a plain "o" plus a modifier, so bare letters
                    // only (the 2026-08-21 gate finding, inherited).
                    if (root.clip-state == 3) {
                        if (event.text == Key.Escape) {
                            root.clip-answer-cancel();
                            return accept;
                        }
                        if (!event.modifiers.control && !event.modifiers.alt
                            && !event.modifiers.meta) {
                            if (event.text == "b" || event.text == "B") {
                                root.clip-answer-keep-both();
                                return accept;
                            }
                            if (event.text == "o" || event.text == "O") {
                                root.clip-answer-overwrite();
                                return accept;
                            }
                        }
                        // Everything else is swallowed, and the question
                        // says out loud that it is still waiting.
                        root.clip-confirm-nudged = true;
                        return accept;
                    }
                    if (event.text == Key.Escape && root.clip-state != 1) {
                        root.clip-close();
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        if (root.clip-state == 0 && root.clip-ready) {
                            root.clip-start();
                            return accept;
                        }
                        if (root.clip-state == 2) {
                            root.clip-close();
                            return accept;
                        }
                    }
                    reject
                }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 560px;
                // THE HEIGHT FOLLOWS THE CONTENT, between a floor and the
                // window (issue #62). It used to be a constant per state,
                // and a constant cannot know how long a sentence is: a
                // selection of thirteen frames in twelve sizes produced a
                // nine-line refusal, the wrapped Text took the room it
                // asked for, the spring below it collapsed to nothing and
                // the button row was laid out BELOW the card — drawn over
                // the scrim (no `clip: true`) and still clickable, because
                // Slint hit-tests children outside their parent.
                //
                // The floor keeps this dialog's proportions in the ordinary
                // case: one plan line and no template field, so it does not
                // want the Copy Picks card's height — an 8-line-tall box
                // holding two sentences reads as a dialog that lost
                // something. The clash question's three answer rows keep
                // their own floor, and the #56 hint needs no special case
                // any more.
                //
                // Above the floor the card grows to whatever the layout
                // asked for. It stops at the window, and THAT is why the
                // body below scrolls: growing alone would only move the
                // overflow to the ceiling, where a wrapped Text still
                // cannot shrink. The row stays inside the card because the
                // body is the only thing the layout may take height from.
                height: clamp(
                    clip-card-layout.preferred-height,
                    min(root.clip-state == 3 ? 380px : 260px, parent.height - 40px),
                    parent.height - 40px);
                border-radius: 8px;
                background: #202028;
                border-width: 1px;
                border-color: #3a3a44;
                init => {
                    root.dbg-card-laid-out("clip card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                // Position AND height: the card is centred, so a height
                // change moves it too, but a card that grew downwards
                // without moving would still have to report.
                changed absolute-position => {
                    root.dbg-card-laid-out("clip card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                changed height => {
                    root.dbg-card-laid-out("clip card", self.absolute-position.x,
                        self.absolute-position.y, self.width, self.height);
                }
                clip-card-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: "Export Frames as Video";
                        color: #ffffff;
                        font-size: 16px;
                    }
                    // Destination, big and unmissable — the same row as
                    // Copy Picks, seeded from its folder until a video
                    // folder is chosen.
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            background: #16161a;
                            border-radius: 4px;
                            height: 34px;
                            Text {
                                x: 10px;
                                text: root.clip-dest == "" ? "No destination chosen" : root.clip-dest;
                                color: root.clip-dest == "" ? #b06060 : #e8e8f0;
                                font-size: 14px;
                                vertical-alignment: center;
                                height: 100%;
                                overflow: elide;
                                width: parent.width - 20px;
                            }
                        }
                        Button {
                            text: "Choose…";
                            enabled: root.clip-state == 0;
                            clicked => {
                                root.clip-pick-dest();
                                clip-keys.focus();
                            }
                        }
                    }
                    // THE GROWING TEXT LIVES HERE, and it SCROLLS instead of
                    // pushing the button row out of the card (issue #62). The card
                    // grows to fit this body up to the window; past that the body
                    // is the only row the layout can shrink (`vertical-stretch`,
                    // no min-height of its own — the header rows and the button
                    // row cannot give up a pixel), so the deficit lands here and
                    // the content scrolls. Nothing is ever truncated, and the
                    // buttons stay inside the card wherever the ceiling can
                    // still hold the fixed rows above and below it (~300px of
                    // window height — video-export.md records the measurement
                    // and the case below it).
                    //
                    // `preferred-height` is the content's, so the CARD's
                    // content-driven height above counts this region at full size
                    // until the ceiling; `viewport-width` is pinned to the view's
                    // own width so nothing ever scrolls sideways. A ScrollView
                    // rather than a bare Flickable: it scrolls the same way and
                    // its scrollbar is the only thing that says a report was cut
                    // off at the ceiling (the clip is line-aligned, so without one
                    // a truncated list looks complete).
                    clip-body := ScrollView {
                        vertical-stretch: 1;
                        min-height: 0px;
                        changed viewport-y => {
                            root.dbg-body-scrolled("clip body", self.viewport-y);
                        }
                        preferred-height: clip-body-content.preferred-height;
                        viewport-width: self.width;
                        viewport-height: clip-body-content.preferred-height;
                        clip-body-content := VerticalLayout {
                            spacing: 10px;
                            // THE plan line: everything the file will be, before a
                            // byte is written.
                            Text {
                                text: root.clip-summary;
                                color: #c8c8d0;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            // What is being left out, and why. Plan state only:
                            // after the run the report carries the same sentence,
                            // and two copies of it on one screen read as two
                            // different facts.
                            if root.clip-skipped != "" && root.clip-state == 0: Text {
                                text: root.clip-skipped;
                                color: #ffb84d;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            // "3 of 30 frames are already in …" (#56). Plan state
                            // only, like the skipped line: it is a thing to know
                            // BEFORE Enter, and the clash question's card has no
                            // room for a fourth sentence above three answer rows.
                            // Grey, not amber — nothing here is wrong, and the
                            // amber line above it is a warning that must stay the
                            // loudest thing in the card.
                            //
                            // ELIDED, NEVER WRAPPED — a two-stem file name reaches
                            // 45 characters, and this dialog's job is one plan
                            // line, not a second line of file name. Core puts the
                            // name LAST for exactly this reason: the counts
                            // survive, the name's tail is what elides. (It used to
                            // be forced by the fixed card height; since #62 the
                            // card would simply grow, so the rule now stands on
                            // what it is worth reading, not on what fits.)
                            if root.clip-exported-hint != "" && root.clip-state == 0: Text {
                                text: root.clip-exported-hint;
                                color: #9898a4;
                                font-size: 12px;
                                overflow: elide;
                            }
                            // THE CLASH QUESTION (clip-state 3), stacked like Copy
                            // Picks': three outcome-labelled answers in order of
                            // increasing consequence, Cancel set apart.
                            if root.clip-state == 3: VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.clip-confirm;
                                    color: #e8e8f0;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 2px; }
                                AnswerRow {
                                    key: "B";
                                    label: root.clip-confirm-keep-both;
                                    // No cost column: this question is about ONE
                                    // file, whose size the plan line above states
                                    // already. Copy Picks needs it because its
                                    // answer costs bytes on top of a run that was
                                    // going out anyway.
                                    clicked => { root.clip-answer-keep-both(); }
                                }
                                AnswerRow {
                                    key: "O";
                                    // The one answer that destroys something wears
                                    // the colour; the BOX never does.
                                    label: root.clip-confirm-overwrite;
                                    label-color: #ffb84d;
                                    clicked => { root.clip-answer-overwrite(); }
                                }
                                Rectangle { height: 4px; }
                                AnswerRow {
                                    key: "Esc";
                                    label: root.clip-confirm-cancel;
                                    clicked => { root.clip-answer-cancel(); }
                                }
                                if root.clip-confirm-nudged: Text {
                                    text: root.clip-confirm-nudge;
                                    color: #ffb84d;
                                    font-size: 12px;
                                }
                            }
                            if root.clip-error != "": Text {
                                text: root.clip-error;
                                color: #ff7a6a;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.clip-state == 1: Text {
                                text: root.clip-progress;
                                color: #c8e8c8;
                                font-size: 13px;
                            }
                            if root.clip-state == 2: Text {
                                text: root.clip-report;
                                color: #c8e8c8;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { } // spring
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        // The witness for issue #62: whatever the sentences
                        // above do, this row must stay inside the card.
                        init => {
                            root.dbg-card-laid-out("clip buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        changed absolute-position => {
                            root.dbg-card-laid-out("clip buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        changed height => {
                            root.dbg-card-laid-out("clip buttons", self.absolute-position.x,
                                self.absolute-position.y, self.width, self.height);
                        }
                        if root.clip-state == 2: Button {
                            text: "Open folder";
                            clicked => { root.clip-open-dest-folder(); }
                        }
                        if root.clip-state == 1: Button {
                            text: "Cancel";
                            clicked => { root.clip-cancel(); }
                        }
                        // A real Cancel button in the plan state, which
                        // the Copy Picks dialog does not have: the scrim
                        // swallows clicks without dismissing, so without
                        // this a mouse-only user has no way out of the
                        // dialog at all. Esc does the same thing.
                        if root.clip-state == 0: Button {
                            text: "Cancel";
                            clicked => { root.clip-close(); }
                        }
                        // No Export button while the question is up: a
                        // greyed fourth control is one more thing to parse
                        // at the moment of choosing (persona).
                        if root.clip-state != 1 && root.clip-state != 3: Button {
                            text: root.clip-state == 2 ? "Close" : "Export";
                            enabled: root.clip-state == 2 || root.clip-ready;
                            clicked => {
                                if (root.clip-state == 2) {
                                    root.clip-close();
                                } else {
                                    root.clip-start();
                                }
                            }
                        }
                    }
                }
            }
            }
            // Owner token from `init` too, for the reason recorded on the
            // copy dialog's init (issue #63 F5).
            init => {
                clip-keys.focus();
                root.focus-owner = -1;
                root.clip-claim-focus = false;
            }
            property <bool> claim-focus: root.clip-claim-focus;
            changed claim-focus => {
                if (self.claim-focus) {
                    clip-keys.focus();
                    root.clip-claim-focus = false;
                }
            }
        }

        // MODAL POPUPS — declared AFTER the IPTC panel and the two export
        // dialogs on purpose (validator M1, issue #23): later elements
        // render on top, and the scrims must cover EVERY layer — the
        // old order left the panel clickable above an "open" modal.
        // Keyboard-shortcuts popup (Help menu; Esc closes). The keyboard map
        // in ui-grid.md is the source of truth for this list.
        if root.shortcuts-visible: ModalScrim {
            width: 100%;
            height: parent.height - statusbar.height;
            card-height: 560px;
            card-padding: 18px;
            dismissed => { root.shortcuts-visible = false; }
            Text {
                text: "Keyboard shortcuts";
                color: #ffffff;
                font-size: 16px;
            }
            Text {
                text: "Arrows / PgUp / PgDn / Home / End   navigate\nY, P or Space   pick (take)\nN or X   reject\nU   clear mark\n+ / -   zoom in / out (grid → loupe fit → ×1.5 steps → 1:1, center held)\nWheel in loupe   zoom, anchored under the pointer (grid: scroll)\nZ   fit → 1:1; zoomed → back to fit (from grid: jump to 1:1)\nClick in loupe   above fit: center on the clicked point\nDouble-click   grid: open in loupe; loupe: 1:1 on the clicked point\nG   back to the grid\nEsc   back to the grid, selection cleared\nK   keyword field (opens the IPTC panel)\nI   IPTC panel\nShift+arrows   extend selection\nCtrl+A   select all (filtered set)\n[ / ]   previous / next burst\nShift+[ / ]   extend the selection by a whole burst\nCtrl+Shift+B   select this burst\nCtrl+O   open folder\nCtrl+E   Copy Picks…\nCtrl+Shift+E   Export Frames as Video…\nCtrl+Q   quit\n1–5, 0   reserved (star ratings, v2)";
                color: #c8c8d0;
                font-size: 13px;
            }
            Text {
                // License line moved to About (issue #23 — its
                // intended home per the M5 deferral note).
                text: "Esc or click to close.";
                color: #707078;
                font-size: 11px;
            }
        }

        // About dialog (issue #23; replaces the About→shortcuts
        // placeholder). Same scrim/close pattern as the shortcuts popup;
        // fully keyboard-contained (see the key handler). The repository
        // URL is plain retype-able text on purpose (no new dependency
        // for a URL opener; persona: it must never wrap or ellipsize —
        // a truncated URL you can't retype is worse than a non-clickable
        // one you can).
        if root.about-visible: ModalScrim {
            width: 100%;
            height: parent.height - statusbar.height;
            // 348px, not 320: issue #26 split the title into two lines,
            // and at the old height the closing hint was pushed outside
            // the rounded rect (QE D2 — a real before/after regression,
            // reproducible at 480x320). The `min` still yields to a
            // short window; the spacing was tightened so the card needs
            // no more room than it did before the split.
            card-height: 348px;
            // Unlike the shortcuts card, clicks on THIS card do not close
            // it (a URL you may be trying to select is on it).
            card-eats-clicks: true;
            dismissed => { root.about-visible = false; }
            // Two lines, not one. A dev build's version is now
            // `X.Y.Z-devel-YYYYMMDD-<hash>` (issue #26), and this
            // Text had no `wrap:` while its neighbours do — Slint
            // clips an unwrapped Text from the RIGHT, which is
            // exactly where the commit hash lives — and that is the
            // one part of the string a bug report cannot lose
            // (persona review 2026-07-31). Measured, today's string
            // occupies ~365px of the 444px content box, so it would
            // NOT have clipped yet; the split is precaution against
            // the next thing that lengthens it, not a fix for an
            // observed truncation. `wrap` is belt-and-braces and
            // does not guarantee against a mid-token break: Unicode
            // line breaking permits one after a hyphen, so the real
            // safety is the width margin. (The version is displayed
            // text, not selectable — a Slint Text cannot be copied;
            // the docs therefore say "include", not "paste".)
            Text {
                text: "FastCull";
                color: #ffffff;
                font-size: 16px;
            }
            Text {
                text: "version " + root.about-version;
                color: #c8c8d0;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "A fast, keyboard-first photo culling tool: fly through a folder of RAW or JPEG photos, pick the keepers, tag them, and copy them out checksum-verified — without ever touching your originals.";
                color: #c8c8d0;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "Main contributor: Danilo de Paula";
                color: #c8c8d0;
                font-size: 13px;
            }
            Text {
                text: "Repository: https://github.com/danilocesar/fastcull";
                color: #c8c8d0;
                font-size: 13px;
            }
            Text {
                text: "Free software, released under the GPL-3.0-or-later license.";
                color: #c8c8d0;
                font-size: 13px;
                wrap: word-wrap;
            }
            Text {
                text: "Esc or click outside to close.";
                color: #707078;
                font-size: 11px;
            }
        }

        statusbar := Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: 26px;
            background: #202024;
            Text {
                text: root.status;
                color: #a8a8b0;
                font-size: 12px;
                x: 10px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}
